SET BDY(GLOBAL) .
UCLIN .
ADD GLOBALZONE
    SREL(Z038)
    FMID(HXYZ110)
    ZONEINDEX((TGT1,SMPE.LAB.CSI,TARGET),
              (DLB1,SMPE.LAB.CSI,DLIB)) .
ENDUCL .
SET BDY(TGT1) .
UCLIN .
ADD TARGETZONE(TGT1) SREL(Z038) RELATED(DLB1) .
ENDUCL .
SET BDY(DLB1) .
UCLIN .
ADD DLIBZONE(DLB1) SREL(Z038) RELATED(TGT1) .
ENDUCL .
