//ALLOCCSI JOB (ACCT),'ALLOC CSI',CLASS=A,MSGCLASS=H
//DEFCSI   EXEC PGM=IDCAMS
//SYSPRINT DD SYSOUT=*
//SYSIN    DD *
  DEFINE CLUSTER (NAME(SMPE.LAB.CSI) -
         FREESPACE(10 5) -
         KEYS(24 0) -
         RECORDSIZE(24 143) -
         SHAREOPTIONS(2 3) -
         UNIQUE -
         VOLUMES(&VOL)) -
         DATA (NAME(SMPE.LAB.CSI.DATA) -
         CONTROLINTERVALSIZE(4096) -
         CYLINDERS(10 5)) -
         INDEX (NAME(SMPE.LAB.CSI.INDEX) -
         CONTROLINTERVALSIZE(4096))
/*
