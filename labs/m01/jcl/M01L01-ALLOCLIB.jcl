//ALLOCLIB JOB (ACCT),'ALLOC LIBS',CLASS=A,MSGCLASS=H
//* ALLOCATE SMP/E LIBRARIES, PRODUCT LIBRARIES, SMPPTFIN, PROCLIB.
//* REPLACE &VOL, OR REMOVE VOL=SER IF STORAGE IS SMS-MANAGED.
//* SMPLOG AND SMPLOGA ARE NOT ALLOCATED HERE; USE SITE STANDARDS.
//ALLOC    EXEC PGM=IEFBR14
//SMPPTS   DD DSN=SMPE.LAB.SMPPTS,DISP=(NEW,CATLG),
//            UNIT=SYSDA,VOL=SER=&VOL,SPACE=(CYL,(10,5,50)),
//            DSNTYPE=LIBRARY,RECFM=FB,LRECL=80,BLKSIZE=0
//SMPSCDS  DD DSN=SMPE.LAB.SMPSCDS,DISP=(NEW,CATLG),
//            UNIT=SYSDA,VOL=SER=&VOL,SPACE=(CYL,(5,5,50)),
//            DSNTYPE=LIBRARY,RECFM=FB,LRECL=80,BLKSIZE=0
//SMPMTS   DD DSN=SMPE.LAB.SMPMTS,DISP=(NEW,CATLG),
//            UNIT=SYSDA,VOL=SER=&VOL,SPACE=(CYL,(5,5,50)),
//            DSNTYPE=LIBRARY,RECFM=FB,LRECL=80,BLKSIZE=0
//SMPSTS   DD DSN=SMPE.LAB.SMPSTS,DISP=(NEW,CATLG),
//            UNIT=SYSDA,VOL=SER=&VOL,SPACE=(CYL,(5,5,50)),
//            DSNTYPE=LIBRARY,RECFM=FB,LRECL=80,BLKSIZE=0
//SMPLTS   DD DSN=SMPE.LAB.SMPLTS,DISP=(NEW,CATLG),
//            UNIT=SYSDA,VOL=SER=&VOL,SPACE=(CYL,(5,5,50)),
//            DSNTYPE=LIBRARY,RECFM=FB,LRECL=80,BLKSIZE=0
//SXYZMAC  DD DSN=SMPE.LAB.SXYZMAC,DISP=(NEW,CATLG),
//            UNIT=SYSDA,VOL=SER=&VOL,SPACE=(TRK,(5,5,10)),
//            DSNTYPE=LIBRARY,RECFM=FB,LRECL=80,BLKSIZE=0
//SXYZSRC  DD DSN=SMPE.LAB.SXYZSRC,DISP=(NEW,CATLG),
//            UNIT=SYSDA,VOL=SER=&VOL,SPACE=(TRK,(5,5,10)),
//            DSNTYPE=LIBRARY,RECFM=FB,LRECL=80,BLKSIZE=0
//AXYZMAC  DD DSN=SMPE.LAB.AXYZMAC,DISP=(NEW,CATLG),
//            UNIT=SYSDA,VOL=SER=&VOL,SPACE=(TRK,(5,5,10)),
//            DSNTYPE=LIBRARY,RECFM=FB,LRECL=80,BLKSIZE=0
//AXYZSRC  DD DSN=SMPE.LAB.AXYZSRC,DISP=(NEW,CATLG),
//            UNIT=SYSDA,VOL=SER=&VOL,SPACE=(TRK,(5,5,10)),
//            DSNTYPE=LIBRARY,RECFM=FB,LRECL=80,BLKSIZE=0
//SMPPTFIN DD DSN=SMPE.LAB.SMPPTFIN,DISP=(NEW,CATLG),
//            UNIT=SYSDA,VOL=SER=&VOL,SPACE=(TRK,(5,5,10)),
//            DSNTYPE=PDS,RECFM=FB,LRECL=80,BLKSIZE=0
//PROCLIB  DD DSN=SMPE.LAB.PROCLIB,DISP=(NEW,CATLG),
//            UNIT=SYSDA,VOL=SER=&VOL,SPACE=(TRK,(2,2,10)),
//            DSNTYPE=PDS,RECFM=FB,LRECL=80,BLKSIZE=0
