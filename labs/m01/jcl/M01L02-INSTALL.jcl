//LAB2     EXEC PGM=GIMSMP,REGION=0M
//SMPOUT   DD SYSOUT=*
//SMPRPT   DD SYSOUT=*
//SMPLIST  DD SYSOUT=*
//SMPCSI   DD DISP=SHR,DSN=SMPE.LAB.CSI
//SMPPTFIN DD DISP=SHR,DSN=SMPE.LAB.SMPPTFIN(HXYZ110)
//SMPCNTL  DD *
  SET BDY(GLOBAL) .
  RECEIVE SELECT(HXYZ110) .
  SET BDY(TGT1) .
  APPLY SELECT(HXYZ110) CHECK .
  APPLY SELECT(HXYZ110) .
  SET BDY(DLB1) .
  ACCEPT SELECT(HXYZ110) .
/*
