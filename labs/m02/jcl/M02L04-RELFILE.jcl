//M02L04F  JOB (ACCT),'SMPE M02 L04',CLASS=A,MSGCLASS=H
//         JCLLIB ORDER=SMPE.LAB.PROCLIB
//BUILD    EXEC PGM=IEBUPDTE,PARM=NEW
//SYSPRINT DD SYSOUT=*
//SYSUT2   DD DISP=OLD,DSN=SMPE.LAB.RELFILE.HXYZ120.F1
//SYSIN    DD *
./ ADD NAME=XYZMAC2,LIST=ALL
         MACRO
&NAME    XYZMAC2 &P1
&NAME    DC    CL8'&P1'
&NAME.9  DC    CL8'REL1'
         MEND
./ ENDUP
