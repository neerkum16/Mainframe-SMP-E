//M02L02R  JOB (ACCT),'SMPE M02 L02',CLASS=A,MSGCLASS=H
//         JCLLIB ORDER=SMPE.LAB.PROCLIB
//RCV      EXEC SMPPROC
//SMP.SMPPTFIN DD DISP=SHR,DSN=SMPE.LAB.SMPPTFIN(UA00002)
//             DD DISP=SHR,DSN=SMPE.LAB.SMPPTFIN(UA00003)
//SMP.SMPHOLD  DD DUMMY
//SMP.SMPCNTL  DD *
  SET BDY(GLOBAL) .
  RECEIVE SYSMODS SELECT(UA00002) SOURCEID(LABSRC1) .
  RECEIVE SYSMODS SELECT(UA00003) SOURCEID(LABSRC2) .
  LIST SYSMODS .
/*
