//ALLOCRF  JOB (ACCT),'ALLOC M02',CLASS=A,MSGCLASS=H
//* ALLOCATE MODULE 2 DATA SETS: SMPCNTL INPUT, HOLDDATA, RELFILE F1.
//* REPLACE &VOL, OR REMOVE VOL=SER IF STORAGE IS SMS-MANAGED.
//ALLOC    EXEC PGM=IEFBR14
//SMPCNTL  DD DSN=SMPE.LAB.SMPCNTL,DISP=(NEW,CATLG),
//            UNIT=SYSDA,VOL=SER=&VOL,SPACE=(TRK,(5,5,20)),
//            DSNTYPE=PDS,RECFM=FB,LRECL=80,BLKSIZE=0
//HOLDDATA DD DSN=SMPE.LAB.HOLDDATA,DISP=(NEW,CATLG),
//            UNIT=SYSDA,VOL=SER=&VOL,SPACE=(TRK,(5,5,10)),
//            DSNTYPE=PDS,RECFM=FB,LRECL=80,BLKSIZE=0
//RELFILE1 DD DSN=SMPE.LAB.RELFILE.HXYZ120.F1,DISP=(NEW,CATLG),
//            UNIT=SYSDA,VOL=SER=&VOL,SPACE=(TRK,(5,5,10)),
//            DSNTYPE=PDS,RECFM=FB,LRECL=80,BLKSIZE=0
