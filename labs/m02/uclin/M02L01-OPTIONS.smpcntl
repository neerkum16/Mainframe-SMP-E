  SET BDY(GLOBAL) .
  UCLIN .
  ADD OPTIONS(GLOBOPT)
      AMS(IDCAMS)
      ASM(ASMA90)
      COMP(IEBCOPY)
      COPY(IEBCOPY)
      COMPACT(YES)
      DSPREFIX(SMPE.LAB.SMPTLIB)
      DSSPACE(5,5,10)
      RETRY(IEBCOPY) .
  ADD GLOBALZONE OPTIONS(GLOBOPT) .
  ENDUCL .
  SET BDY(TGT1) .
  UCLIN .
  ADD TARGETZONE(TGT1) OPTIONS(GLOBOPT) .
  ENDUCL .
  SET BDY(DLB1) .
  UCLIN .
  ADD DLIBZONE(DLB1) OPTIONS(GLOBOPT) .
  ENDUCL .
