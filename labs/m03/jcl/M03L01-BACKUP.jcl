//M03L01B  JOB (ACCT),'SMPE M03 BKUP',CLASS=A,MSGCLASS=H
//* BACK UP THE CSI AND THE LIBRARIES THAT MODULE 3 CHANGES.
//* EACH RUN REPLACES THE PREVIOUS BACKUP (SUFFIX .BKUP).
//* REPLACE &VOL, OR REMOVE VOL=SER IF STORAGE IS SMS-MANAGED.
//DELOLD   EXEC PGM=IDCAMS
//SYSPRINT DD SYSOUT=*
//SYSIN    DD *
  DELETE SMPE.LAB.CSI.BKUP
  DELETE SMPE.LAB.SMPSCDS.BKUP
  DELETE SMPE.LAB.SMPPTS.BKUP
  DELETE SMPE.LAB.SXYZMAC.BKUP
  DELETE SMPE.LAB.SXYZSRC.BKUP
  DELETE SMPE.LAB.SXYZLOAD.BKUP
  DELETE SMPE.LAB.SXYZDATA.BKUP
  SET MAXCC = 0
/*
//BKCSI    EXEC PGM=IDCAMS
//SYSPRINT DD SYSOUT=*
//IN       DD DISP=SHR,DSN=SMPE.LAB.CSI
//OUT      DD DSN=SMPE.LAB.CSI.BKUP,DISP=(NEW,CATLG),
//            UNIT=SYSDA,VOL=SER=&VOL,SPACE=(CYL,(5,5)),
//            RECFM=VB,LRECL=256,BLKSIZE=0
//SYSIN    DD *
  REPRO INFILE(IN) OUTFILE(OUT)
/*
//BKSCDS   EXEC PGM=IEBCOPY
//SYSPRINT DD SYSOUT=*
//IN       DD DISP=SHR,DSN=SMPE.LAB.SMPSCDS
//OUT      DD DSN=SMPE.LAB.SMPSCDS.BKUP,DISP=(NEW,CATLG),
//            UNIT=SYSDA,VOL=SER=&VOL,SPACE=(CYL,(5,5,50)),
//            DSNTYPE=LIBRARY,RECFM=FB,LRECL=80,BLKSIZE=0
//SYSIN    DD *
  COPY INDD=IN,OUTDD=OUT
/*
//BKPTS    EXEC PGM=IEBCOPY
//SYSPRINT DD SYSOUT=*
//IN       DD DISP=SHR,DSN=SMPE.LAB.SMPPTS
//OUT      DD DSN=SMPE.LAB.SMPPTS.BKUP,DISP=(NEW,CATLG),
//            UNIT=SYSDA,VOL=SER=&VOL,SPACE=(CYL,(10,5,50)),
//            DSNTYPE=LIBRARY,RECFM=FB,LRECL=80,BLKSIZE=0
//SYSIN    DD *
  COPY INDD=IN,OUTDD=OUT
/*
//BKMAC    EXEC PGM=IEBCOPY
//SYSPRINT DD SYSOUT=*
//IN       DD DISP=SHR,DSN=SMPE.LAB.SXYZMAC
//OUT      DD DSN=SMPE.LAB.SXYZMAC.BKUP,DISP=(NEW,CATLG),
//            UNIT=SYSDA,VOL=SER=&VOL,SPACE=(TRK,(5,5,10)),
//            DSNTYPE=LIBRARY,RECFM=FB,LRECL=80,BLKSIZE=0
//SYSIN    DD *
  COPY INDD=IN,OUTDD=OUT
/*
//BKSRC    EXEC PGM=IEBCOPY
//SYSPRINT DD SYSOUT=*
//IN       DD DISP=SHR,DSN=SMPE.LAB.SXYZSRC
//OUT      DD DSN=SMPE.LAB.SXYZSRC.BKUP,DISP=(NEW,CATLG),
//            UNIT=SYSDA,VOL=SER=&VOL,SPACE=(TRK,(5,5,10)),
//            DSNTYPE=LIBRARY,RECFM=FB,LRECL=80,BLKSIZE=0
//SYSIN    DD *
  COPY INDD=IN,OUTDD=OUT
/*
//BKLOAD   EXEC PGM=IEBCOPY
//SYSPRINT DD SYSOUT=*
//IN       DD DISP=SHR,DSN=SMPE.LAB.SXYZLOAD
//OUT      DD DSN=SMPE.LAB.SXYZLOAD.BKUP,DISP=(NEW,CATLG),
//            UNIT=SYSDA,VOL=SER=&VOL,SPACE=(TRK,(5,5,10)),
//            DSNTYPE=LIBRARY,RECFM=U,BLKSIZE=32760
//SYSIN    DD *
  COPY INDD=IN,OUTDD=OUT
/*
//BKDATA   EXEC PGM=IEBCOPY
//SYSPRINT DD SYSOUT=*
//IN       DD DISP=SHR,DSN=SMPE.LAB.SXYZDATA
//OUT      DD DSN=SMPE.LAB.SXYZDATA.BKUP,DISP=(NEW,CATLG),
//            UNIT=SYSDA,VOL=SER=&VOL,SPACE=(TRK,(5,5,10)),
//            DSNTYPE=LIBRARY,RECFM=FB,LRECL=80,BLKSIZE=0
//SYSIN    DD *
  COPY INDD=IN,OUTDD=OUT
/*
