//M03L07R  JOB (ACCT),'SMPE M03 L07',CLASS=A,MSGCLASS=H
//         JCLLIB ORDER=SMPE.LAB.PROCLIB
//RCV      EXEC SMPPROC
//SMP.SMPPTFIN DD DISP=SHR,DSN=SMPE.LAB.SMPPTFIN(UA00011)
//             DD DISP=SHR,DSN=SMPE.LAB.SMPPTFIN(UA00012)
//SMP.SMPHOLD  DD DUMMY
//SMP.SMPCNTL  DD *
  SET BDY(GLOBAL) .
  RECEIVE SYSMODS SELECT(UA00011,UA00012) SOURCEID(LABM03) .
/*
//CHK1     EXEC SMPPROC
//SMP.SMPCNTL  DD *
  SET BDY(TGT1) .
  APPLY SELECT(UA00011) CHECK .
/*
//CHK2     EXEC SMPPROC
//SMP.SMPCNTL  DD *
  SET BDY(TGT1) .
  APPLY SELECT(UA00012) CHECK .
