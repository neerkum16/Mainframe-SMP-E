//M03L01R  JOB (ACCT),'SMPE M03 RSTR',CLASS=A,MSGCLASS=H
//* RESTORE THE STATE SAVED BY M03L01-BACKUP: DELETE THE CSI AND THE
//* LIBRARIES, RECREATE THEM, AND LOAD THE BACKUP COPIES.
//* NO SMP/E JOB MAY BE RUNNING. REPLACE &VOL.
//DELALL   EXEC PGM=IDCAMS
//SYSPRINT DD SYSOUT=*
//SYSIN    DD *
  DELETE SMPE.LAB.CSI CLUSTER
  DELETE SMPE.LAB.SMPSCDS
  DELETE SMPE.LAB.SMPPTS
  DELETE SMPE.LAB.SXYZMAC
  DELETE SMPE.LAB.SXYZSRC
  DELETE SMPE.LAB.SXYZLOAD
  DELETE SMPE.LAB.SXYZDATA
  SET MAXCC = 0
/*
//DEFCSI   EXEC PGM=IDCAMS
//SYSPRINT DD SYSOUT=*
//SYSIN    DD *
  DEFINE CLUSTER (NAME(SMPE.LAB.CSI) -
         FREESPACE(10 5) -
         KEYS(24 0) -
         RECORDSIZE(24 143) -
         SHAREOPTIONS(2 3) -
         UNIQUE -
         VOLUMES(&VOL)) -
         DATA (NAME(SMPE.LAB.CSI.DATA) -
         CONTROLINTERVALSIZE(4096) -
         CYLINDERS(10 5)) -
         INDEX (NAME(SMPE.LAB.CSI.INDEX) -
         CONTROLINTERVALSIZE(4096))
/*
//LDCSI    EXEC PGM=IDCAMS
//SYSPRINT DD SYSOUT=*
//IN       DD DISP=SHR,DSN=SMPE.LAB.CSI.BKUP
//OUT      DD DISP=SHR,DSN=SMPE.LAB.CSI
//SYSIN    DD *
  REPRO INFILE(IN) OUTFILE(OUT)
/*
//RSSCDS   EXEC PGM=IEBCOPY
//SYSPRINT DD SYSOUT=*
//IN       DD DISP=SHR,DSN=SMPE.LAB.SMPSCDS.BKUP
//OUT      DD DSN=SMPE.LAB.SMPSCDS,DISP=(NEW,CATLG),
//            LIKE=SMPE.LAB.SMPSCDS.BKUP,UNIT=SYSDA,VOL=SER=&VOL
//SYSIN    DD *
  COPY INDD=IN,OUTDD=OUT
/*
//RSPTS    EXEC PGM=IEBCOPY
//SYSPRINT DD SYSOUT=*
//IN       DD DISP=SHR,DSN=SMPE.LAB.SMPPTS.BKUP
//OUT      DD DSN=SMPE.LAB.SMPPTS,DISP=(NEW,CATLG),
//            LIKE=SMPE.LAB.SMPPTS.BKUP,UNIT=SYSDA,VOL=SER=&VOL
//SYSIN    DD *
  COPY INDD=IN,OUTDD=OUT
/*
//RSMAC    EXEC PGM=IEBCOPY
//SYSPRINT DD SYSOUT=*
//IN       DD DISP=SHR,DSN=SMPE.LAB.SXYZMAC.BKUP
//OUT      DD DSN=SMPE.LAB.SXYZMAC,DISP=(NEW,CATLG),
//            LIKE=SMPE.LAB.SXYZMAC.BKUP,UNIT=SYSDA,VOL=SER=&VOL
//SYSIN    DD *
  COPY INDD=IN,OUTDD=OUT
/*
//RSSRC    EXEC PGM=IEBCOPY
//SYSPRINT DD SYSOUT=*
//IN       DD DISP=SHR,DSN=SMPE.LAB.SXYZSRC.BKUP
//OUT      DD DSN=SMPE.LAB.SXYZSRC,DISP=(NEW,CATLG),
//            LIKE=SMPE.LAB.SXYZSRC.BKUP,UNIT=SYSDA,VOL=SER=&VOL
//SYSIN    DD *
  COPY INDD=IN,OUTDD=OUT
/*
//RSLOAD   EXEC PGM=IEBCOPY
//SYSPRINT DD SYSOUT=*
//IN       DD DISP=SHR,DSN=SMPE.LAB.SXYZLOAD.BKUP
//OUT      DD DSN=SMPE.LAB.SXYZLOAD,DISP=(NEW,CATLG),
//            LIKE=SMPE.LAB.SXYZLOAD.BKUP,UNIT=SYSDA,VOL=SER=&VOL
//SYSIN    DD *
  COPY INDD=IN,OUTDD=OUT
/*
//RSDATA   EXEC PGM=IEBCOPY
//SYSPRINT DD SYSOUT=*
//IN       DD DISP=SHR,DSN=SMPE.LAB.SXYZDATA.BKUP
//OUT      DD DSN=SMPE.LAB.SXYZDATA,DISP=(NEW,CATLG),
//            LIKE=SMPE.LAB.SXYZDATA.BKUP,UNIT=SYSDA,VOL=SER=&VOL
//SYSIN    DD *
  COPY INDD=IN,OUTDD=OUT
/*
