//ALLOCLB3 JOB (ACCT),'ALLOC M03',CLASS=A,MSGCLASS=H
//* ALLOCATE MODULE 3 LIBRARIES.
//* TARGET: SXYZLOAD (MODULES), SXYZDATA AND SXYZDATX (DATA).
//* DISTRIBUTION: AXYZMOD (MODULES), AXYZDATA (DATA).
//* XYZOBJ HOLDS OBJECT TEXT THAT SMP/E READS THROUGH TXLIB.
//* REPLACE &VOL, OR REMOVE VOL=SER IF STORAGE IS SMS-MANAGED.
//ALLOC    EXEC PGM=IEFBR14
//SXYZLOAD DD DSN=SMPE.LAB.SXYZLOAD,DISP=(NEW,CATLG),
//            UNIT=SYSDA,VOL=SER=&VOL,SPACE=(TRK,(5,5,10)),
//            DSNTYPE=LIBRARY,RECFM=U,BLKSIZE=32760
//SXYZDATA DD DSN=SMPE.LAB.SXYZDATA,DISP=(NEW,CATLG),
//            UNIT=SYSDA,VOL=SER=&VOL,SPACE=(TRK,(5,5,10)),
//            DSNTYPE=LIBRARY,RECFM=FB,LRECL=80,BLKSIZE=0
//SXYZDATX DD DSN=SMPE.LAB.SXYZDATX,DISP=(NEW,CATLG),
//            UNIT=SYSDA,VOL=SER=&VOL,SPACE=(TRK,(5,5,10)),
//            DSNTYPE=LIBRARY,RECFM=FB,LRECL=80,BLKSIZE=0
//AXYZMOD  DD DSN=SMPE.LAB.AXYZMOD,DISP=(NEW,CATLG),
//            UNIT=SYSDA,VOL=SER=&VOL,SPACE=(TRK,(5,5,10)),
//            DSNTYPE=LIBRARY,RECFM=FB,LRECL=80,BLKSIZE=0
//AXYZDATA DD DSN=SMPE.LAB.AXYZDATA,DISP=(NEW,CATLG),
//            UNIT=SYSDA,VOL=SER=&VOL,SPACE=(TRK,(5,5,10)),
//            DSNTYPE=LIBRARY,RECFM=FB,LRECL=80,BLKSIZE=0
//XYZOBJ   DD DSN=SMPE.LAB.XYZOBJ,DISP=(NEW,CATLG),
//            UNIT=SYSDA,VOL=SER=&VOL,SPACE=(TRK,(5,5,10)),
//            DSNTYPE=PDS,RECFM=FB,LRECL=80,BLKSIZE=0
