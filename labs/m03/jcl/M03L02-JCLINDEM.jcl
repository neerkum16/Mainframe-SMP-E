//XYZDEMO  JOB (ACCT),'JCLIN DEMO',CLASS=A,MSGCLASS=H
//* JCLIN INPUT FOR THE JCLIN COMMAND IN M03-L02. NOT A JOB TO SUBMIT.
//* STEP ASMD DESCRIBES AN ASSEMBLY; STEP LNKD DESCRIBES A LINK-EDIT.
//ASMD     EXEC PGM=ASMA90,PARM='OBJECT,NODECK'
//SYSLIB   DD DSN=SMPE.LAB.SXYZMAC,DISP=SHR
//SYSLIN   DD DSN=SMPE.LAB.AXYZMOD(XYZDMOD),DISP=SHR
//SYSIN    DD *
XYZDMOD  CSECT
         SR    15,15
         BR    14
         END
/*
//LNKD     EXEC PGM=IEWL,PARM='XREF,LIST,LET'
//SYSLMOD  DD DSN=SMPE.LAB.SXYZLOAD,DISP=SHR
//AXYZMOD  DD DSN=SMPE.LAB.AXYZMOD,DISP=SHR
//SYSLIN   DD *
  INCLUDE AXYZMOD(XYZDMOD)
  NAME XYZDEMO(R)
/*
