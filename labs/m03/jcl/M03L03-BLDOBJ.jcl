//M03L03B  JOB (ACCT),'SMPE M03 L03',CLASS=A,MSGCLASS=H
//* ASSEMBLE XYZMOD1 INTO THE OBJECT TEXT LIBRARY THAT SMP/E READS
//* THROUGH TXLIB(XYZOBJ). THE SOURCE MATCHES THE ASSEMBLER INPUT
//* IN THE JCLIN OF JXYZ112.
//ASM      EXEC PGM=ASMA90,PARM='OBJECT,NODECK'
//SYSPRINT DD SYSOUT=*
//SYSLIB   DD DISP=SHR,DSN=SYS1.MACLIB
//SYSUT1   DD UNIT=SYSDA,SPACE=(CYL,(5,5))
//SYSLIN   DD DISP=SHR,DSN=SMPE.LAB.XYZOBJ(XYZMOD1)
//SYSIN    DD *
XYZMOD1  CSECT
XYZMOD1  AMODE 31
XYZMOD1  RMODE ANY
         SR    15,15
         BR    14
         DC    C'XYZMOD1 LEVEL 1.1.2'
         END
/*
