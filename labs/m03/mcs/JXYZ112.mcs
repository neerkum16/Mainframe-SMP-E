++FUNCTION(JXYZ112) .
++VER(Z038) FMID(HXYZ110) .
++JCLIN .
//JXYZ112  JOB (ACCT),'JXYZ112',CLASS=A,MSGCLASS=H
//ASM1     EXEC PGM=ASMA90,PARM='OBJECT,NODECK'
//SYSLIB   DD DSN=SMPE.LAB.SXYZMAC,DISP=SHR
//         DD DSN=SMPE.LAB.AXYZMAC,DISP=SHR
//SYSLIN   DD DSN=SMPE.LAB.AXYZMOD(XYZMOD1),DISP=SHR
//SYSIN    DD *
XYZMOD1  CSECT
XYZMOD1  AMODE 31
XYZMOD1  RMODE ANY
         SR    15,15
         BR    14
         DC    C'XYZMOD1 LEVEL 1.1.2'
         END
/*
//LINK1    EXEC PGM=IEWL,PARM='XREF,LIST,LET'
//SYSLMOD  DD DSN=SMPE.LAB.SXYZLOAD,DISP=SHR
//AXYZMOD  DD DSN=SMPE.LAB.AXYZMOD,DISP=SHR
//SYSLIN   DD *
  INCLUDE AXYZMOD(XYZMOD1)
  NAME XYZLMOD1(R)
/*
//COPY1    EXEC PGM=IEBCOPY
//SYSPRINT DD SYSOUT=*
//AXYZDATA DD DSN=SMPE.LAB.AXYZDATA,DISP=SHR
//SXYZDATA DD DSN=SMPE.LAB.SXYZDATA,DISP=SHR
//SYSIN    DD *
  COPY INDD=AXYZDATA,OUTDD=SXYZDATA
/*
++MOD(XYZMOD1) DISTLIB(AXYZMOD) SYSLIB(SXYZLOAD) TXLIB(XYZOBJ) .
++MAC(XYZMAC9) DISTLIB(AXYZMAC) SYSLIB(SXYZMAC) .
         MACRO
&NAME    XYZMAC9 &P1
&NAME    DC    CL8'&P1'
         MEND
++SRC(XYZSRC2) DISTLIB(AXYZSRC) SYSLIB(SXYZSRC) .
* XYZ SAMPLE SOURCE 2, LEVEL 1.1.2
XYZSAMP2 CSECT
         END
++DATA(XYZPARM) DISTLIB(AXYZDATA) SYSLIB(SXYZDATA) .
LEVEL=1.1.2
OPTION=BASE
