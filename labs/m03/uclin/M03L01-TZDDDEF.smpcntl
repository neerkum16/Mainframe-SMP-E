  SET BDY(TGT1) .
  UCLIN .
  ADD DDDEF(SXYZLOAD) DA(SMPE.LAB.SXYZLOAD) SHR .
  ADD DDDEF(SXYZDATA) DA(SMPE.LAB.SXYZDATA) SHR .
  ADD DDDEF(AXYZMOD)  DA(SMPE.LAB.AXYZMOD)  SHR .
  ADD DDDEF(AXYZMAC)  DA(SMPE.LAB.AXYZMAC)  SHR .
  ADD DDDEF(AXYZDATA) DA(SMPE.LAB.AXYZDATA) SHR .
  ADD DDDEF(SMPLTS)   DA(SMPE.LAB.SMPLTS)   SHR .
  ADD DDDEF(MACLIB)   DA(SYS1.MACLIB)       SHR .
  ADD DDDEF(MODGEN)   DA(SYS1.MODGEN)       SHR .
  ADD DDDEF(SYSLIB)   CONCAT(SMPMTS,MACLIB,MODGEN,SXYZMAC,AXYZMAC) .
  ENDUCL .
